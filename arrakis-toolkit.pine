// Gelecek ayırıcı yazıları zamana göre sıralanıp mini grafiklerin üzerinde yukarı doğru dizilir, birbirine ve mumlara girmez
float futRng  = ta.highest(high, 100) - ta.lowest(low, 100)
float futTop  = ta.highest(high, 100) + futRng * (HTF_H - 100) / 200
float futStep = futRng * 0.03
if barstate.islast
    array<label> futs = array.new<label>()
    array<int>   futX = array.new<int>()
    for sp in array.from(sepW, sepD, sepH, sepM, sepX1, sepX2, sepX3)
        if not na(sp.futLb)
            futs.push(sp.futLb)
            futX.push(sp.futLb.get_x())
    for [row, idx] in futX.sort_indices()
        futs.get(idx).set_y(futTop + (row + 2) * futStep)

// ───────────────────────── Önceki gün / hafta / ay seviyeleri ─────────────────────────
type PrevLvl
    string       name
    bool         on
    color        col
    string       style
    int          width
    int          keep
    int          maxSec
    array<Level> hist
    bool         seen  = false
    float        hi    = na
    float        lo    = na
    int          hiBar = na
    int          loBar = na

method addLevel(PrevLvl p, float price, int x, bool isHigh) =>
    line  ln = line.new(x, price, bar_index, price, color = p.col, style = lineStyle(p.style), width = p.width)
    label lb = label.new(bar_index, price, p.name + (isHigh ? "H" : "L"), style = label.style_label_lower_right, color = color.new(color.black, 100), textcolor = p.col, size = labelSize(LBL_SIZE))
    Level lv = Level.new(ln, lb, price, isHigh, bar_index, na, 0, p.col)
    p.hist.push(lv)
    pending.push(lv)

// Dönem değişince biten dönemin high/low'u, oluştuğu bardan başlayan seviyeye dönüşür
method track(PrevLvl p, bool isNew) =>
    if isNew
        if p.seen and p.on and timeframe.in_seconds() <= p.maxSec
            p.addLevel(p.hi, p.hiBar, true)
            p.addLevel(p.lo, p.loBar, false)
            while p.hist.size() > p.keep * 2
                p.hist.shift().kill()
        p.seen  := true
        p.hi    := high
        p.lo    := low
        p.hiBar := bar_index
        p.loBar := bar_index
    else
        if na(p.hi) or high > p.hi
            p.hi    := high
            p.hiBar := bar_index
        if na(p.lo) or low < p.lo
            p.lo    := low
            p.loBar := bar_index

var PrevLvl prevD = PrevLvl.new("PD", pdOn, pdCol, pdSty, pdW, pdN, timeframe.in_seconds(pdTf), array.new<Level>())
var PrevLvl prevW = PrevLvl.new("PW", pwOn, pwCol, pwSty, pwW, pwN, timeframe.in_seconds(pwTf), array.new<Level>())
var PrevLvl prevM = PrevLvl.new("PM", pmOn, pmCol, pmSty, pmW, pmN, timeframe.in_seconds(pmTf), array.new<Level>())

prevD.track(newDay)
prevW.track(newWeek)
prevM.track(newMonth)

// ───────────────────────── Açılış boşlukları ─────────────────────────
type GapItem
    box   bx
    line  ce
    float top
    float bot
    bool  up
    bool  live  = true
    int   ceBar = na
    label lb    = na

type Gap
    string         name
    bool           on
    color          fill
    color          lineCol
    int            keep
    int            maxSec
    array<GapItem> items

// Önceki mumun kapanışı ile yeni mumun açılışı arasındaki boşluk, dolana kadar sağa uzanan kutu olur
method add(Gap g, float pc) =>
    float top = math.max(pc, open)
    float bot = math.min(pc, open)
    if g.on and timeframe.in_seconds() <= g.maxSec and top > bot
        box  bx = box.new(bar_index, top, bar_index, bot, border_color = g.lineCol, bgcolor = g.fill)
        line ce = GAP_CE ? line.new(bar_index, (top + bot) / 2, bar_index, (top + bot) / 2, color = g.lineCol, style = line.style_dashed) : na
        g.items.push(GapItem.new(bx, ce, top, bot, open > pc))
        if g.items.size() > g.keep
            GapItem old = g.items.shift()
            box.delete(old.bx)
            line.delete(old.ce)
            label.delete(old.lb)

// Yukarı boşluk fiyat alt kenara inince, aşağı boşluk üst kenara çıkınca dolmuş sayılır ve o barda durur
// Fiyat orta çizgiye değince (yarı dolum) CE çizgisi soluklaşır
// Yazı: uzayan boşlukta son mumun sağında; dolunca orta çizgiye değen ilk mumdan önce biter, o hizada mum yoktur
method grow(Gap g) =>
    for it in g.items
        if it.live
            it.bx.set_right(bar_index)
            line.set_x2(it.ce, bar_index)
            float mid = (it.top + it.bot) / 2
            if na(it.ceBar) and (it.up ? low <= mid : high >= mid)
                it.ceBar := bar_index - 2
                line.set_color(it.ce, color.new(g.lineCol, 75))
            if it.up ? low <= it.bot : high >= it.top
                it.live := false
                label.delete(it.lb)
                it.lb := label.new(it.ceBar, mid, g.name, style = label.style_label_right, color = color.new(color.black, 100), textcolor = g.lineCol, size = size.normal)
            else if barstate.islast
                label.delete(it.lb)
                it.lb := label.new(bar_index + 2, mid, g.name, style = label.style_label_left, color = color.new(color.black, 100), textcolor = g.lineCol, size = size.normal)

var Gap nwog = Gap.new("NWOG", nwOn, nwFill, nwLine, nwN, timeframe.in_seconds(nwTf), array.new<GapItem>())
var Gap ndog = Gap.new("NDOG", ndOn, ndFill, ndLine, ndN, timeframe.in_seconds(ndTf), array.new<GapItem>())

float prevClose = close[1]
// Hafta başında günlük boşluk haftalıkla aynıdır, sadece NWOG çizilir
if newWeek
    nwog.add(prevClose)
else if newDay
    ndog.add(prevClose)
nwog.grow()
ndog.grow()

// ───────────────────────── FVG motoru ─────────────────────────
type FvgItem
    box   bx
    line  ce
    float top
    float bot
    bool  up
    int   tStart
    int   endT
    int   ceT = na
    label lb  = na
    int   conf = na

type FvgTf
    string         name
    color          col
    int            ext
    array<FvgItem> live
    int            lastT = na
    int            fill  = 85
    string         fmt   = "dd.MM HH:mm"

extMs(string s) =>
    switch s
        "1 gün"   => DAY_MS
        "2 gün"   => 2 * DAY_MS
        "3 gün"   => 3 * DAY_MS
        "5 gün"   => 5 * DAY_MS
        "1 hafta" => 7 * DAY_MS
        "2 hafta" => 14 * DAY_MS
        "1 ay"    => 30 * DAY_MS
        "2 ay"    => 61 * DAY_MS
        "3 ay"    => 91 * DAY_MS
        "6 ay"    => 182 * DAY_MS
        "1 yıl"   => 365 * DAY_MS
        "4 yıl"   => 1461 * DAY_MS
        => int(na)

// HTF bağlamında çalışır: lookahead ile birlikte [1] son kapanmış mumu verir, FVG sonradan kaybolmaz
fvgPack() =>
    bool  up  = low[1] > high[3]
    bool  dn  = high[1] < low[3]
    float top = up ? low[1] : low[3]
    float bot = up ? high[3] : high[1]
    [up, dn, top, bot, time[3], time[1], time_close[1]]

int fvgGapT = time[2]

// Grafikten uzaklaştıkça dolgu açılır ama hiçbir zaman tamamen şeffaf olmaz
fvgFill(string tf) =>
    float ratio = timeframe.in_seconds(tf) / timeframe.in_seconds()
    not CLEAN or ratio <= 24 ? 85 : ratio <= 96 ? 89 : 92

// Fiyata en yakın olmayan ve dolmuş FVG'lerin dolgusu
fvgDim(int t) => CLEAN ? math.min(t + 6, 96) : t

// Fiyatın üstündeki ve altındaki en yakın FVG'nin sırası
fvgNearest(array<FvgItem> items) =>
    int   aI = -1
    int   bI = -1
    float aD = na
    float bD = na
    for [i, it] in items
        bool  above = it.bot > close
        float d     = above ? it.bot - close : math.max(close - it.top, 0.0)
        if above and (aI < 0 or d < aD)
            aI := i
            aD := d
        else if not above and (bI < 0 or d < bD)
            bI := i
            bD := d
    [aI, bI]

fvgFmt(string tf) => timeframe.in_seconds(tf) >= 86400 ? "dd.MM.yyyy" : "dd.MM HH:mm"

method fvgText(FvgTf f, FvgItem it) => FVG_TM and not na(it.conf) ? f.name + " · " + str.format_time(it.conf, f.fmt, TZ) : f.name

method drawBody(FvgTf f, FvgItem it, int tRight, bool near = true) =>
    float mid = (it.top + it.bot) / 2
    bool  dim = CLEAN and not near
    it.bx := box.new(it.tStart, it.top, tRight, it.bot, xloc = xloc.bar_time, border_color = color.new(f.col, dim ? 85 : 70), bgcolor = color.new(f.col, near ? f.fill : fvgDim(f.fill)))
    it.ce := FVG_CE ? line.new(it.tStart, mid, tRight, mid, xloc = xloc.bar_time, color = color.new(f.col, dim ? 88 : na(it.ceT) ? 0 : 75), style = line.style_dashed) : na

// Üç mumun kapanışında FVG eklenir; o zaman diliminde üç mumun ilkinin açılışından başlar, tamamen dolunca veya süresi bitince durur.
// Yazı: uzayan FVG'de son mumun sağında; duran FVG'de orta çizgiye değen ilk mumdan önce biter, o hizada mum yoktur.
// Uzayanlar son barda yeniden çizilir: böylece eski HTF FVG'leri 500 çizim sınırında silinmez.
method scan(FvgTf f, bool ok, bool up, bool dn, float top, float bot, int tFirst, int tLast, int tConf) =>
    if ok and not na(tLast) and (na(f.lastT) or tLast != f.lastT)
        f.lastT := tLast
        if up or dn
            FvgItem nw = FvgItem.new(na, na, top, bot, up, tFirst, na(f.ext) ? na : time + f.ext, conf = tConf)
            f.drawBody(nw, time)
            f.live.push(nw)
    if f.live.size() > 0
        int aI = -1
        int bI = -1
        if barstate.islast
            [nA, nB] = fvgNearest(f.live)
            aI := nA
            bI := nB
        for i = f.live.size() - 1 to 0
            FvgItem it = f.live.get(i)
            float mid = (it.top + it.bot) / 2
            it.bx.set_right(time)
            line.set_x2(it.ce, time)
            if na(it.ceT) and (it.up ? low <= mid : high >= mid)
                it.ceT := fvgGapT
                line.set_color(it.ce, color.new(f.col, 75))
            if (it.up ? low <= it.bot : high >= it.top) or (not na(it.endT) and time >= it.endT)
                label.delete(it.lb)
                f.live.remove(i)
                if CLEAN
                    it.bx.set_bgcolor(color.new(f.col, fvgDim(f.fill)))
                    it.bx.set_border_color(color.new(f.col, 85))
                    line.set_color(it.ce, color.new(f.col, 88))
                it.lb := label.new(na(it.ceT) ? time : it.ceT, mid, f.fvgText(it), xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.black, 100), textcolor = CLEAN ? color.new(f.col, 45) : f.col, size = size.normal)
            else if barstate.islast
                box.delete(it.bx)
                line.delete(it.ce)
                label.delete(it.lb)
                f.drawBody(it, time, i == aI or i == bI)
                it.lb := label.new(time + 2 * timeframe.in_seconds() * 1000, mid, f.fvgText(it), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = f.col, size = size.normal)

bool fv1Ok  = FVG_ON and fv1On and timeframe.in_seconds("1") >= timeframe.in_seconds()
bool fv2Ok  = FVG_ON and fv2On and timeframe.in_seconds("5") >= timeframe.in_seconds()
bool fv3Ok  = FVG_ON and fv3On and timeframe.in_seconds("15") >= timeframe.in_seconds()
bool fv4Ok  = FVG_ON and fv4On and timeframe.in_seconds("30") >= timeframe.in_seconds()
bool fv5Ok  = FVG_ON and fv5On and timeframe.in_seconds("60") >= timeframe.in_seconds()
bool fv6Ok  = FVG_ON and fv6On and timeframe.in_seconds("240") >= timeframe.in_seconds()
bool fv7Ok  = FVG_ON and fv7On and timeframe.in_seconds("480") >= timeframe.in_seconds()
bool fv8Ok  = FVG_ON and fv8On and timeframe.in_seconds("D") >= timeframe.in_seconds()
bool fv9Ok  = FVG_ON and fv9On and timeframe.in_seconds("W") >= timeframe.in_seconds()
bool fv10Ok = FVG_ON and fv10On and timeframe.in_seconds("M") >= timeframe.in_seconds()

[fv1U, fv1D, fv1T, fv1B, fv1S, fv1L, fv1C]       = request.security(syminfo.tickerid, fv1Ok ? "1" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv2U, fv2D, fv2T, fv2B, fv2S, fv2L, fv2C]       = request.security(syminfo.tickerid, fv2Ok ? "5" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv3U, fv3D, fv3T, fv3B, fv3S, fv3L, fv3C]       = request.security(syminfo.tickerid, fv3Ok ? "15" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv4U, fv4D, fv4T, fv4B, fv4S, fv4L, fv4C]       = request.security(syminfo.tickerid, fv4Ok ? "30" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv5U, fv5D, fv5T, fv5B, fv5S, fv5L, fv5C]       = request.security(syminfo.tickerid, fv5Ok ? "60" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv6U, fv6D, fv6T, fv6B, fv6S, fv6L, fv6C]       = request.security(syminfo.tickerid, fv6Ok ? "240" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv7U, fv7D, fv7T, fv7B, fv7S, fv7L, fv7C]       = request.security(syminfo.tickerid, fv7Ok ? "480" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv8U, fv8D, fv8T, fv8B, fv8S, fv8L, fv8C]       = request.security(syminfo.tickerid, fv8Ok ? "D" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv9U, fv9D, fv9T, fv9B, fv9S, fv9L, fv9C]       = request.security(syminfo.tickerid, fv9Ok ? "W" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)
[fv10U, fv10D, fv10T, fv10B, fv10S, fv10L, fv10C] = request.security(syminfo.tickerid, fv10Ok ? "M" : timeframe.period, fvgPack(), lookahead = barmerge.lookahead_on)

var FvgTf fv1  = FvgTf.new("1m FVG", fv1Col, extMs(fv1Ext), array.new<FvgItem>(), fill = fvgFill("1"), fmt = fvgFmt("1"))
var FvgTf fv2  = FvgTf.new("5m FVG", fv2Col, extMs(fv2Ext), array.new<FvgItem>(), fill = fvgFill("5"), fmt = fvgFmt("5"))
var FvgTf fv3  = FvgTf.new("15m FVG", fv3Col, extMs(fv3Ext), array.new<FvgItem>(), fill = fvgFill("15"), fmt = fvgFmt("15"))
var FvgTf fv4  = FvgTf.new("30m FVG", fv4Col, extMs(fv4Ext), array.new<FvgItem>(), fill = fvgFill("30"), fmt = fvgFmt("30"))
var FvgTf fv5  = FvgTf.new("1h FVG", fv5Col, extMs(fv5Ext), array.new<FvgItem>(), fill = fvgFill("60"), fmt = fvgFmt("60"))
var FvgTf fv6  = FvgTf.new("4h FVG", fv6Col, extMs(fv6Ext), array.new<FvgItem>(), fill = fvgFill("240"), fmt = fvgFmt("240"))
var FvgTf fv7  = FvgTf.new("8h FVG", fv7Col, extMs(fv7Ext), array.new<FvgItem>(), fill = fvgFill("480"), fmt = fvgFmt("480"))
var FvgTf fv8  = FvgTf.new("1D FVG", fv8Col, extMs(fv8Ext), array.new<FvgItem>(), fill = fvgFill("D"), fmt = fvgFmt("D"))
var FvgTf fv9  = FvgTf.new("1W FVG", fv9Col, extMs(fv9Ext), array.new<FvgItem>(), fill = fvgFill("W"), fmt = fvgFmt("W"))
var FvgTf fv10 = FvgTf.new("1M FVG", fv10Col, extMs(fv10Ext), array.new<FvgItem>(), fill = fvgFill("M"), fmt = fvgFmt("M"))

fv1.scan(fv1Ok, fv1U, fv1D, fv1T, fv1B, fv1S, fv1L, fv1C)
fv2.scan(fv2Ok, fv2U, fv2D, fv2T, fv2B, fv2S, fv2L, fv2C)
fv3.scan(fv3Ok, fv3U, fv3D, fv3T, fv3B, fv3S, fv3L, fv3C)
fv4.scan(fv4Ok, fv4U, fv4D, fv4T, fv4B, fv4S, fv4L, fv4C)
fv5.scan(fv5Ok, fv5U, fv5D, fv5T, fv5B, fv5S, fv5L, fv5C)
fv6.scan(fv6Ok, fv6U, fv6D, fv6T, fv6B, fv6S, fv6L, fv6C)
fv7.scan(fv7Ok, fv7U, fv7D, fv7T, fv7B, fv7S, fv7L, fv7C)
fv8.scan(fv8Ok, fv8U, fv8D, fv8T, fv8B, fv8S, fv8L, fv8C)
fv9.scan(fv9Ok, fv9U, fv9D, fv9T, fv9B, fv9S, fv9L, fv9C)
fv10.scan(fv10Ok, fv10U, fv10D, fv10T, fv10B, fv10S, fv10L, fv10C)

// ───────────────────────── Midnight Open motoru ─────────────────────────
var array<line>  moLines  = array.new<line>()
var array<label> moLabels = array.new<label>()
var bool         moLive   = false
bool             moNew    = tod == 0 and tod[1] != 0

// Fiyat çizgiyi gün içinde defalarca geçebilir; bu yüzden temasta durmaz, 17:00 NY'de biter
if moOn and timeframe.in_seconds() <= timeframe.in_seconds(moTf)
    if moNew
        moLines.push(line.new(bar_index, open, bar_index, open, color = moCol, style = lineStyle(moSty), width = moW))
        moLabels.push(label.new(bar_index, open, "MO", style = label.style_label_lower_right, color = color.new(color.black, 100), textcolor = moCol, size = labelSize(LBL_SIZE)))
        moLive := true
        if moLines.size() > moN
            line.delete(moLines.shift())
            label.delete(moLabels.shift())
    else if moLive
        if tod < 17 * 60
            moLines.last().set_x2(bar_index)
            moLabels.last().set_x(bar_index)
        else
            moLive := false

// ───────────────────────── Seviye uzatma ─────────────────────────
// Fitil değerse o barda durur ve alındı olarak işaretlenir.
// Killzone seviyeleri ayrıca EXT_DAYS işlem günü sonra seansın bittiği saatte durur; önceki gün/hafta/ay seviyelerinin süresi yoktur.
if pending.size() > 0
    for i = pending.size() - 1 to 0
        Level lv = pending.get(i)
        if lv.dead
            pending.remove(i)
            continue
        if newTradingDay and bar_index > lv.startBar
            lv.days := lv.days + 1
        bool touched = lv.isHigh ? high >= lv.price : low <= lv.price
        bool expired = not na(lv.endTod) and (lv.days > EXT_DAYS or (lv.days == EXT_DAYS and tod >= lv.endTod))
        if not expired
            lv.ln.set_x2(bar_index)
            lv.lb.set_x(bar_index)
            if touched
                lv.markTaken()
        if touched or expired
            pending.remove(i)

// ───────────────────────── Watermark ─────────────────────────
string G_WMT   = "Watermark (üst)"
bool   wmtOn   = input.bool(false, "Göster", group = G_WMT)
string wmtPos  = input.string("Orta", "Konum", options = ["Sol", "Orta", "Sağ"], group = G_WMT)
string wmtSize = input.string("Normal", "Boyut", options = ["Çok küçük", "Küçük", "Normal", "Büyük", "Çok büyük"], group = G_WMT)
color  wmtCol  = input.color(color.new(#2E0602, 70), "Renk", group = G_WMT)
string wmtFont = input.string("Normal", "Yazı tipi", options = ["Normal", "Monospace"], group = G_WMT)
bool   wmtSym  = input.bool(true, "Sembol", inline = "wmtc", group = G_WMT)
bool   wmtExch = input.bool(true, "Borsa", inline = "wmtc", group = G_WMT)
bool   wmtTf   = input.bool(true, "Zaman dilimi", inline = "wmtc", group = G_WMT)
string wmtTxt  = input.string("", "Ek metin", group = G_WMT)

string G_WMB   = "Watermark (alt)"
bool   wmbOn   = input.bool(true, "Göster", group = G_WMB)
string wmbPos  = input.string("Orta", "Konum", options = ["Sol", "Orta", "Sağ"], group = G_WMB)
string wmbSize = input.string("Normal", "Boyut", options = ["Çok küçük", "Küçük", "Normal", "Büyük", "Çok büyük"], group = G_WMB)
color  wmbCol  = input.color(color.new(#2E0602, 70), "Renk", group = G_WMB)
string wmbFont = input.string("Normal", "Yazı tipi", options = ["Normal", "Monospace"], group = G_WMB)
bool   wmbSym  = input.bool(true, "Sembol", inline = "wmbc", group = G_WMB)
bool   wmbExch = input.bool(true, "Borsa", inline = "wmbc", group = G_WMB)
bool   wmbTf   = input.bool(true, "Zaman dilimi", inline = "wmbc", group = G_WMB)
string wmbTxt  = input.string("", "Ek metin", group = G_WMB)
bool   wmbDate = input.bool(true, "Grafiğin tarihi (alt satır)", tooltip = "Son mumun NY tarihini yazar. Tekrar oynatta geri sardığın günü gösterir, bugünü değil.", group = G_WMB)

// 1m, 5m, 1h, 4h, 1D, 1W, 1M
tfText() =>
    int m = timeframe.multiplier
    if timeframe.isseconds
        str.tostring(m) + "s"
    else if timeframe.isminutes
        m % 60 == 0 ? str.tostring(int(m / 60)) + "h" : str.tostring(m) + "m"
    else if timeframe.isdaily
        str.tostring(m) + "D"
    else if timeframe.isweekly
        str.tostring(m) + "W"
    else if timeframe.ismonthly
        str.tostring(m) + "M"
    else
        timeframe.period

wmText(bool sym, bool exch, bool tf, string extra) =>
    string s = sym ? (exch ? syminfo.prefix + ":" + syminfo.ticker : syminfo.ticker) : ""
    if tf
        s := s == "" ? tfText() : s + " | " + tfText()
    extra == "" ? s : s == "" ? extra : s + " - " + extra

// Son mumun NY tarihi: 05 Ocak 2026 · Pazartesi
wmDate(int t) =>
    array<string> ay  = array.from("Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık")
    array<string> gun = array.from("Pazar", "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi")
    str.format_time(t, "dd", TZ) + " " + ay.get(month(t, TZ) - 1) + " " + str.tostring(year(t, TZ)) + " · " + gun.get(dayofweek(t, TZ) - 1)

wmPosition(string p, bool top) =>
    switch p
        "Sol" => top ? position.top_left : position.bottom_left
        "Sağ" => top ? position.top_right : position.bottom_right
        => top ? position.top_center : position.bottom_center

wmSize(string s) =>
    switch s
        "Çok küçük" => size.tiny
        "Küçük"     => size.small
        "Büyük"     => size.large
        "Çok büyük" => size.huge
        => size.normal

wmFont(string f) => f == "Monospace" ? font.family_monospace : font.family_default

var table wmTop    = table.new(wmPosition(wmtPos, true), 1, 1)
var table wmBottom = table.new(wmPosition(wmbPos, false), 1, 1)

if barstate.islast
    if wmtOn
        wmTop.cell(0, 0, wmText(wmtSym, wmtExch, wmtTf, wmtTxt), text_color = wmtCol, text_size = wmSize(wmtSize), text_font_family = wmFont(wmtFont))
    if wmbOn
        string wb = wmText(wmbSym, wmbExch, wmbTf, wmbTxt)
        if wmbDate
            wb := wb == "" ? wmDate(time) : wb + "\n" + wmDate(time)
        wmBottom.cell(0, 0, wb, text_color = wmbCol, text_size = wmSize(wmbSize), text_font_family = wmFont(wmbFont))

// ───────────────────────── HTF mumları motoru ─────────────────────────
// Grafiğin zaman dilimine göre [üst, alt] grup: 1m → 15m/1h, 5m → 1h/1D, 15m → 4h/1D, 1h–4h → 1D/1W, üstü → 1M/3M
autoHtf(bool upper) =>
    int s = timeframe.in_seconds()
    s <= 60 ? (upper ? "15" : "60") : s <= 300 ? (upper ? "60" : "D") : s <= 900 ? (upper ? "240" : "D") : s <= 14400 ? (upper ? "D" : "W") : (upper ? "M" : "3M")

tfLabel(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 60 ? str.tostring(s) + "s" : s < 3600 ? str.tostring(int(s / 60)) + "m" : s < 86400 ? str.tostring(int(s / 3600)) + "h" : s < 604800 ? str.tostring(int(s / 86400)) + "D" : s < 2419200 ? str.tostring(int(s / 604800)) + "W" : str.tostring(math.round(s / 2629800)) + "M"

fmtLeft(int ms) =>
    int s   = math.max(0, int(ms / 1000))
    int d   = int(s / 86400)
    int h   = int((s % 86400) / 3600)
    int m   = int((s % 3600) / 60)
    int sec = s % 60
    d > 0 ? str.format("{0}g {1,number,00}:{2,number,00}", d, h, m) : h > 0 ? str.format("{0,number,00}:{1,number,00}:{2,number,00}", h, m, sec) : str.format("{0,number,00}:{1,number,00}", m, sec)

// Dizi döndüren istekler sadece son mumlarda dolar: her mumda dizi üretmek bellek sınırını aşar
reqLive() => time >= last_bar_time - 5 * timeframe.in_seconds() * 1000

// HTF bağlamında çalışır: son HTF_N mumun OHLC'si ve zamanı (0 = oluşan mum)
htfPack() =>
    bool live = reqLive()
    array<float> o = live ? array.new<float>(HTF_N) : na
    array<float> h = live ? array.new<float>(HTF_N) : na
    array<float> l = live ? array.new<float>(HTF_N) : na
    array<float> c = live ? array.new<float>(HTF_N) : na
    array<int>   t = live ? array.new<int>(HTF_N) : na
    array<int>   d = live ? array.new<int>(HTF_N) : na
    if live
        for i = 0 to HTF_N - 1
            o.set(i, open[i])
            h.set(i, high[i])
            l.set(i, low[i])
            c.set(i, close[i])
            t.set(i, timeframe.isdaily ? time_tradingday[i] : time[i])
            d.set(i, time_tradingday[i])
    [o, h, l, c, t, d, time_close]

string htf1   = HTF1_SEL == "Otomatik" ? autoHtf(true) : HTF1_TF
string htf2   = HTF2_SEL == "Otomatik" ? autoHtf(false) : HTF2_TF
bool   htf1Ok = HTF_ON and timeframe.in_seconds(htf1) > timeframe.in_seconds()
bool   htf2Ok = HTF_ON and timeframe.in_seconds(htf2) > timeframe.in_seconds()

[aO, aH, aL, aC, aT, aD, aTc] = request.security(syminfo.tickerid, htf1Ok ? htf1 : timeframe.period, htfPack())
[bO, bH, bL, bC, bT, bD, bTc] = request.security(syminfo.tickerid, htf2Ok ? htf2 : timeframe.period, htfPack())

// SMT karşı sembolü: vadelilerde kök, diğerlerinde sembol adıyla eşlenir; ":" içeren sonuç kendi borsasını taşır
smtTarget(string k) =>
    switch k
        "EURUSD"    => "GBPUSD"
        "GBPUSD"    => "EURUSD"
        "AUDUSD"    => "NZDUSD"
        "NZDUSD"    => "AUDUSD"
        "USDJPY"    => "USDCHF"
        "USDCHF"    => "USDJPY"
        "USDCAD"    => "USDCHF"
        "EURJPY"    => "GBPJPY"
        "GBPJPY"    => "EURJPY"
        "XAUUSD"    => "XAGUSD"
        "XAGUSD"    => "XAUUSD"
        "DXY"       => "OANDA:EURUSD"
        "NAS100USD" => "SPX500USD"
        "SPX500USD" => "NAS100USD"
        "US30USD"   => "SPX500USD"
        "NAS100"    => "SPX500"
        "SPX500"    => "NAS100"
        "US100"     => "US500"
        "US500"     => "US100"
        "US30"      => "US500"
        "SPX"       => "NASDAQ:NDX"
        "NDX"       => "SP:SPX"
        "SPY"       => "NASDAQ:QQQ"
        "QQQ"       => "AMEX:SPY"
        "NQ"        => "ES"
        "ES"        => "NQ"
        "MNQ"       => "MES"
        "MES"       => "MNQ"
        "RTY"       => "ES"
        "M2K"       => "MES"
        "YM"        => "CME_MINI:ES"
        "MYM"       => "CME_MINI:MES"
        "GC"        => "SI"
        "SI"        => "GC"
        "6E"        => "6B"
        "6B"        => "6E"
        "BTC"       => "ETH"
        "ETH"       => "BTC"
        "MBT"       => "MET"
        "MET"       => "MBT"
        => ""

bool   smtFut    = syminfo.type == "futures" and str.length(syminfo.root) > 0
string smtTo     = smtTarget(smtFut ? syminfo.root : syminfo.ticker)
bool   smtBtc    = not smtFut and str.contains(syminfo.ticker, "BTC")
bool   smtEth    = not smtFut and str.contains(syminfo.ticker, "ETH")
string smtName0  = smtFut ? str.replace(syminfo.ticker, syminfo.root, smtTo) : smtBtc ? str.replace(syminfo.ticker, "BTC", "ETH") : smtEth ? str.replace(syminfo.ticker, "ETH", "BTC") : smtTo
bool   smtAutoOk = str.length(smtTo) > 0 or smtBtc or smtEth
string smtAuto   = not smtAutoOk ? "" : str.contains(smtName0, ":") ? smtName0 : syminfo.prefix + ":" + smtName0
string smtSym    = SMT_SEL == "Elle" ? SMT_SYM : smtAuto
bool   smtInv    = SMT_SEL == "Elle" ? SMT_INV : syminfo.ticker == "DXY"
bool   smtOk     = HTF_ON and HTF_SMT and str.length(smtSym) > 0
string smtName   = str.length(smtSym) > 0 ? str.split(smtSym, ":").last() : ""
string smtNote   = smtOk ? " · SMT " + smtName + (smtInv ? " (ters)" : "") : ""

[_, smt1H, smt1L, _, smt1T, _, _] = request.security(smtOk ? smtSym : syminfo.tickerid, htf1Ok ? htf1 : timeframe.period, htfPack(), ignore_invalid_symbol = true)
[_, smt2H, smt2L, _, smt2T, _, _] = request.security(smtOk ? smtSym : syminfo.tickerid, htf2Ok ? htf2 : timeframe.period, htfPack(), ignore_invalid_symbol = true)

// TradingView en fazla 500 bar ileriye çizer; gerekirse mumlar sıklaşır
int htfStep = math.min(HTF_STEP, int((490 - HTF_OFF) / HTF_N))

// Mini mumların yerleşeceği dikey alan: son 100 barın aralığı, üst ve alt yarıya bölünür
float refHi = ta.highest(high, 100)
float refLo = ta.lowest(low, 100)

var array<box>   htfBoxes  = array.new<box>()
var array<line>  htfLines  = array.new<line>()
var array<label> htfLabels = array.new<label>()

scaleY(float p, float gLo, float rng, float bBot, float bTop) => bBot + (p - gLo) / rng * (bTop - bBot)

// Mini grafikteki FVG'ler FVG menüsündeki rengi ve süreyi kullanır; menüde olmayan zaman diliminde süre sınırı yoktur
fvgColOf(int sec) =>
    switch sec
        60      => fv1Col
        300     => fv2Col
        900     => fv3Col
        1800    => fv4Col
        3600    => fv5Col
        14400   => fv6Col
        28800   => fv7Col
        86400   => fv8Col
        604800  => fv9Col
        2628000 => fv10Col
        => HTF_WICK

fvgExtOf(int sec) =>
    switch sec
        60      => extMs(fv1Ext)
        300     => extMs(fv2Ext)
        900     => extMs(fv3Ext)
        1800    => extMs(fv4Ext)
        3600    => extMs(fv5Ext)
        14400   => extMs(fv6Ext)
        28800   => extMs(fv7Ext)
        86400   => extMs(fv8Ext)
        604800  => extMs(fv9Ext)
        2628000 => extMs(fv10Ext)
        => int(na)

drawGroup(int x0, int stp, int nS, string tf, array<float> o, array<float> h, array<float> l, array<float> c, array<int> t, array<int> d, int tc, float bTop, float bBot, bool titleTop) =>
    float gHi = h.slice(0, nS).max()
    float gLo = l.slice(0, nS).min()
    float rng = gHi - gLo
    if rng > 0
        int xEnd = x0 + nS * stp
        if HTF_GRID
            for k = 0 to 4
                float y = scaleY(gLo + rng * k / 4, gLo, rng, bBot, bTop)
                htfLines.push(line.new(x0, y, xEnd, y, color = color.new(HTF_WICK, 85), style = line.style_dotted))
        // FVG menüsüyle aynı kural: üç mumun ilkinden başlar, tamamen dolunca veya süresi bitince durur, CE'ye değince orta çizgi soluklaşır
        if HTF_FVGS
            int   tfSec = timeframe.in_seconds(tf)
            color fCol  = fvgColOf(tfSec)
            int   fExt  = fvgExtOf(tfSec)
            for i = 1 to nS - 3
                bool up = l.get(i) > h.get(i + 2)
                bool dn = h.get(i) < l.get(i + 2)
                if up or dn
                    float top   = up ? l.get(i) : l.get(i + 2)
                    float bot   = up ? h.get(i + 2) : h.get(i)
                    float fMid  = (top + bot) / 2
                    int   stopK = 0
                    bool  ceHit = false
                    for k = i - 1 to 0
                        if up ? l.get(k) <= fMid : h.get(k) >= fMid
                            ceHit := true
                        if (up ? l.get(k) <= bot : h.get(k) >= top) or (not na(fExt) and t.get(k) >= t.get(i) + fExt)
                            stopK := k
                            break
                    int   xL = x0 + (nS - 3 - i) * stp
                    int   xR = x0 + (nS - 1 - stopK) * stp
                    float yM = scaleY(fMid, gLo, rng, bBot, bTop)
                    htfBoxes.push(box.new(xL, scaleY(top, gLo, rng, bBot, bTop), xR, scaleY(bot, gLo, rng, bBot, bTop), border_color = color.new(fCol, 70), bgcolor = color.new(fCol, 85)))
                    if FVG_CE
                        htfLines.push(line.new(xL, yM, xR, yM, color = color.new(fCol, ceHit ? 75 : 0), style = line.style_dashed))
        string timeFmt = timeframe.in_seconds(tf) < 86400 ? "dd.MM HH:mm" : "dd.MM.yy"
        string timeTz  = timeframe.in_seconds(tf) == 86400 ? "UTC" : TZ
        for j = 0 to nS - 1
            int i = nS - 1 - j   // en eski solda
            if not na(o.get(i))
                int   x  = x0 + j * stp
                float yO = scaleY(o.get(i), gLo, rng, bBot, bTop)
                float yC = scaleY(c.get(i), gLo, rng, bBot, bTop)
                color bodyCol = c.get(i) >= o.get(i) ? HTF_UP : HTF_DN
                // Günlük ayırıcı: ana grafiktekinin rengi ve stiliyle, yeni işlem gününün ilk mumunda
                if dOn and timeframe.in_seconds(tf) < 86400 and i < nS - 1 and not na(d.get(i + 1)) and d.get(i) != d.get(i + 1)
                    htfLines.push(line.new(x, bBot, x, bTop, color = dCol, style = lineStyle(dSty), width = dW))
                // Gövde tek bar genişliğinde, kalınlığını kenar çizgisi verir; böylece mumlar ana grafik sıklığında durur
                // Kenar: önce HTF_WICK renginde tam kalınlıkta gövde, rengi farklıysa üstüne 2 piksel ince gövde
                htfLines.push(line.new(x, scaleY(h.get(i), gLo, rng, bBot, bTop), x, scaleY(l.get(i), gLo, rng, bBot, bTop), color = HTF_WICK))
                htfBoxes.push(box.new(x, math.max(yO, yC), x, math.min(yO, yC), border_color = HTF_WICK, border_width = HTF_PX, bgcolor = HTF_WICK))
                if bodyCol != HTF_WICK
                    htfBoxes.push(box.new(x, math.max(yO, yC), x, math.min(yO, yC), border_color = bodyCol, border_width = math.max(1, HTF_PX - 2), bgcolor = bodyCol))
                // Zaman yazıları iki grubun arasındaki boşlukta durur
                if HTF_TIME and i % 20 == 0
                    htfLabels.push(label.new(x, titleTop ? bBot : bTop, str.format_time(t.get(i), timeFmt, timeTz), style = titleTop ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(HTF_WICK, 30), size = size.normal))
        if HTF_LAST and not na(c.get(0))
            float yL  = scaleY(c.get(0), gLo, rng, bBot, bTop)
            color lCol = c.get(0) >= o.get(0) ? HTF_UP : HTF_DN
            htfLines.push(line.new(x0, yL, xEnd, yL, color = color.new(lCol, 40), style = line.style_dotted))
        htfLabels.push(label.new(x0, titleTop ? bTop : bBot, tfLabel(tf) + " · " + fmtLeft(tc - timenow) + smtNote, style = titleTop ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(color.black, 100), textcolor = HTF_WICK, size = size.normal))

// Solunda ve sağında p mumdan daha uç olan swing; eşit tepelerde eskisi sayılır
isPivot(array<float> a, int i, int p, bool hi) =>
    bool ok = not na(a.get(i))
    if ok
        for k = i - p to i + p
            if k != i
                float v = a.get(k)
                if na(v) or (hi ? v > a.get(i) : v < a.get(i)) or (k < i and v == a.get(i))
                    ok := false
                    break
    ok

// Swing iki sembolde birkaç mum kayabilir; o yüzden aynı zamanın ±p mumundaki en uç mum alınır
smtIdx(array<float> a, int j, int p, bool hi) =>
    int best = -1
    for k = math.max(0, j - p) to math.min(a.size() - 1, j + p)
        float v = a.get(k)
        if not na(v) and (best < 0 or (hi ? v > a.get(best) : v < a.get(best)))
            best := k
    best

// Bir sembolün art arda iki swing'i, ana grafiğin mum sırasıyla kaydedilir; yeni swing önce gelecek şekilde sıralanabilir
smtCollect(array<int> keys, array<float> src, array<int> srcT, array<int> t, int nS, bool hi) =>
    int prev = -1
    for i = SMT_P + 1 to nS - 1 - SMT_P
        if isPivot(src, i, SMT_P, hi)
            int m = t.indexof(srcT.get(i))
            if m >= 0
                if prev >= 0 and not keys.includes(prev * 1000 + m)
                    keys.push(prev * 1000 + m)
                prev := m
    keys

// İki sembolden birinin art arda iki swing'inde biri seviyeyi alıp diğeri almadıysa SMT'dir; high'larda bearish, low'larda bullish
// İki sembolün swing'leri de taranır: aynı uyumsuzluk iki paritenin grafiğinde de aynı mumlar arasında çıkar
smtSide(int x0, int stp, int nS, array<float> a, array<float> xa, array<int> t, array<int> xT, bool hi, float gLo, float rng, float bBot, float bTop) =>
    color cl    = hi ? SMT_BEAR : SMT_BULL
    bool  cHi   = smtInv ? not hi : hi
    int   found = 0
    array<int> keys = array.new<int>()
    array<int> seen = array.new<int>()
    smtCollect(keys, a, t, t, nS, hi)
    smtCollect(keys, xa, xT, t, nS, cHi)
    keys.sort()
    for key in keys
        if found < SMT_MAX
            int cB = int(key / 1000)
            int cA = key % 1000
            int jA = xT.indexof(t.get(cA))
            int jB = xT.indexof(t.get(cB))
            if jA >= 0 and jB >= 0
                int eA = smtIdx(a, cA, SMT_P, hi)
                int eB = smtIdx(a, cB, SMT_P, hi)
                int oA = smtIdx(xa, jA, SMT_P, cHi)
                int oB = smtIdx(xa, jB, SMT_P, cHi)
                // Oluşan mum sayılmaz; iki pencere aynı muma denk gelirse kıyas yapılamaz
                if eA > eB and eB >= 1 and oA > oB and oB >= 1 and not seen.includes(eB * 1000 + eA)
                    bool mainTook  = hi ? a.get(eB) > a.get(eA) : a.get(eB) < a.get(eA)
                    bool otherTook = cHi ? xa.get(oB) > xa.get(oA) : xa.get(oB) < xa.get(oA)
                    if mainTook != otherTook
                        seen.push(eB * 1000 + eA)
                        int   xA = x0 + (nS - 1 - eA) * stp
                        int   xB = x0 + (nS - 1 - eB) * stp
                        float yA = scaleY(a.get(eA), gLo, rng, bBot, bTop)
                        float yB = scaleY(a.get(eB), gLo, rng, bBot, bTop)
                        htfLines.push(line.new(xA, yA, xB, yB, color = cl, style = line.style_dashed))
                        htfLabels.push(label.new(xB, yB, CLEAN ? "SMT " + smtName + (otherTook ? " ✓" : " ✗") : "SMT · " + smtName + (otherTook ? " aldı" : " almadı"), style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cl, size = size.small))
                        found += 1
    found

drawSmt(int x0, int stp, int nS, array<float> h, array<float> l, array<int> t, array<float> xH, array<float> xL, array<int> xT, float bTop, float bBot) =>
    float gHi = h.slice(0, nS).max()
    float gLo = l.slice(0, nS).min()
    float rng = gHi - gLo
    if rng > 0 and not na(xT)
        smtSide(x0, stp, nS, h, smtInv ? xL : xH, t, xT, true, gLo, rng, bBot, bTop)
        smtSide(x0, stp, nS, l, smtInv ? xH : xL, t, xT, false, gLo, rng, bBot, bTop)
    rng

if barstate.islast
    for b in htfBoxes
        b.delete()
    for ln in htfLines
        ln.delete()
    for lb in htfLabels
        lb.delete()
    htfBoxes.clear()
    htfLines.clear()
    htfLabels.clear()
    float mid = (refHi + refLo) / 2
    float pad = (refHi - refLo) * 0.08
    float ext = (refHi - refLo) * (HTF_H - 100) / 200
    if htf1Ok and not na(aO)
        drawGroup(bar_index + HTF_OFF, htfStep, HTF_N, htf1, aO, aH, aL, aC, aT, aD, aTc, refHi + ext, mid + pad, true)
        if smtOk
            drawSmt(bar_index + HTF_OFF, htfStep, HTF_N, aH, aL, aT, smt1H, smt1L, smt1T, refHi + ext, mid + pad)
    if htf2Ok and not na(bO)
        drawGroup(bar_index + HTF_OFF, htfStep, HTF_N, htf2, bO, bH, bL, bC, bT, bD, bTc, mid - pad, refLo - ext, false)
        if smtOk
            drawSmt(bar_index + HTF_OFF, htfStep, HTF_N, bH, bL, bT, smt2H, smt2L, smt2T, mid - pad, refLo - ext)

// ───────────────────────── Ana grafikte SMT ─────────────────────────
string smtMTf = SMT_MSEL == "Otomatik" ? autoHtf(true) : SMT_MTF
bool   smtMOk = SMT_MON and str.length(smtSym) > 0 and timeframe.in_seconds(smtMTf) > timeframe.in_seconds()

// HTF bağlamında çalışır: son 100 mum; t iki sembolü eşlemek için, x mumun gerçek açılış zamanı
smtMPack() =>
    bool live = reqLive()
    array<float> h = live ? array.new<float>(100) : na
    array<float> l = live ? array.new<float>(100) : na
    array<int>   t = live ? array.new<int>(100) : na
    array<int>   x = live ? array.new<int>(100) : na
    if live
        for i = 0 to 99
            h.set(i, high[i])
            l.set(i, low[i])
            t.set(i, timeframe.isdaily ? time_tradingday[i] : time[i])
            x.set(i, time[i])
    [h, l, t, x]

[smH, smL, smT, smX] = request.security(syminfo.tickerid, smtMOk ? smtMTf : timeframe.period, smtMPack())
[soH, soL, soT, _]   = request.security(smtMOk ? smtSym : syminfo.tickerid, smtMOk ? smtMTf : timeframe.period, smtMPack(), ignore_invalid_symbol = true)

// Çizginin ucu fitilin üstüne otursun diye HTF mumunun içindeki en uç grafik mumu aranır
var array<float> smtBarH = array.new<float>()
var array<float> smtBarL = array.new<float>()
var array<int>   smtBarT = array.new<int>()
if smtMOk
    smtBarH.push(high)
    smtBarL.push(low)
    smtBarT.push(time)
    if smtBarT.size() > 3000
        smtBarH.shift()
        smtBarL.shift()
        smtBarT.shift()

smtBarOf(int tFrom, int tTo, bool hi) =>
    int   best = na
    float val  = na
    for k = smtBarT.size() - 1 to 0
        int tk = smtBarT.get(k)
        if tk < tFrom
            break
        if tk < tTo
            float v = hi ? smtBarH.get(k) : smtBarL.get(k)
            if na(val) or (hi ? v > val : v < val)
                val  := v
                best := tk
    na(best) ? tFrom : best

var array<line>  smtMLines  = array.new<line>()
var array<label> smtMLabels = array.new<label>()

// Mini grafiklerle aynı kural; fark çizimin ana grafikte, gerçek fiyat ve zamanda olması
smtMainSide(array<float> a, array<float> xa, array<int> t, array<int> x, array<int> xT, bool hi) =>
    color cl    = hi ? SMT_MBEAR : SMT_MBULL
    bool  cHi   = smtInv ? not hi : hi
    int   found = 0
    array<int> keys = array.new<int>()
    array<int> seen = array.new<int>()
    smtCollect(keys, a, t, t, 100, hi)
    smtCollect(keys, xa, xT, t, 100, cHi)
    keys.sort()
    for key in keys
        if found < SMT_MMAX
            int cB = int(key / 1000)
            int cA = key % 1000
            int jA = xT.indexof(t.get(cA))
            int jB = xT.indexof(t.get(cB))
            if jA >= 0 and jB >= 0
                int eA = smtIdx(a, cA, SMT_P, hi)
                int eB = smtIdx(a, cB, SMT_P, hi)
                int oA = smtIdx(xa, jA, SMT_P, cHi)
                int oB = smtIdx(xa, jB, SMT_P, cHi)
                if eA > eB and eB >= 1 and oA > oB and oB >= 1 and not seen.includes(eB * 1000 + eA)
                    bool mainTook  = hi ? a.get(eB) > a.get(eA) : a.get(eB) < a.get(eA)
                    bool otherTook = cHi ? xa.get(oB) > xa.get(oA) : xa.get(oB) < xa.get(oA)
                    if mainTook != otherTook
                        seen.push(eB * 1000 + eA)
                        int tA = smtBarOf(x.get(eA), x.get(eA - 1), hi)
                        int tB = smtBarOf(x.get(eB), x.get(eB - 1), hi)
                        // İlk bulunan en yenisidir; eskiler soluk kalır
                        color  smC = CLEAN and found > 0 ? color.new(cl, 45) : cl
                        string smS = CLEAN ? "SMT " + tfLabel(smtMTf) + " " + smtName + (otherTook ? " ✓" : " ✗") : "SMT " + tfLabel(smtMTf) + " · " + smtName + (otherTook ? " aldı" : " almadı")
                        smtMLines.push(line.new(tA, a.get(eA), tB, a.get(eB), xloc = xloc.bar_time, color = smC, style = line.style_dashed))
                        smtMLabels.push(label.new(tB, a.get(eB), smS, xloc = xloc.bar_time, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = smC, size = size.normal))
                        found += 1
    found

if barstate.islast
    for ln in smtMLines
        ln.delete()
    for lb in smtMLabels
        lb.delete()
    smtMLines.clear()
    smtMLabels.clear()
    if smtMOk and not na(soT) and not na(smT)
        smtMainSide(smH, smtInv ? soL : soH, smT, smX, soT, true)
        smtMainSide(smL, smtInv ? soH : soL, smT, smX, soT, false)
