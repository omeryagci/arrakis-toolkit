// Arrakis Toolkit — kişisel kullanım

//@version=6
indicator("Arrakis Toolkit", "Arrakis", overlay = true, max_bars_back = 100, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────── HTF mumları ─────────────────────────
// En üstte: grafikteki HTF mumlarına çift tıklayınca zaman dilimi hemen buradan seçilir.
string G_HTF    = "HTF mumları"
bool   HTF_ON   = input.bool(true, "HTF mumlarını göster", group = G_HTF)
string HTF1_SEL = input.string("Otomatik", "Üst grup", options = ["Otomatik", "Elle"], inline = "htf1", group = G_HTF)
string HTF1_TF  = input.timeframe("60", "", inline = "htf1", group = G_HTF)
string HTF2_SEL = input.string("Otomatik", "Alt grup", options = ["Otomatik", "Elle"], inline = "htf2", group = G_HTF)
string HTF2_TF  = input.timeframe("D", "", inline = "htf2", group = G_HTF)
int    HTF_N    = input.int(60, "Mum sayısı", minval = 10, maxval = 100, group = G_HTF)
int    HTF_OFF  = input.int(10, "Grafikten uzaklık (bar)", minval = 1, maxval = 200, group = G_HTF)
int    HTF_STEP = input.int(1, "Mum aralığı (bar)", minval = 1, maxval = 5, tooltip = "1: mini mumlar ana grafiğin mumlarıyla aynı sıklıkta durur.", group = G_HTF)
int    HTF_PX   = input.int(4, "Mum kalınlığı (piksel)", minval = 1, maxval = 10, tooltip = "Grafiği çok uzaklaştırınca mumlar birbirine girerse azalt.", group = G_HTF)
int    HTF_H    = input.int(120, "Dikey boy (%)", minval = 100, maxval = 200, step = 5, tooltip = "100: son 100 mumun yüksekliğine sığar. Büyüdükçe mini grafikler yukarı ve aşağı uzar, genişlikleri değişmez.", group = G_HTF)
color  HTF_UP   = input.color(#2E0602, "Mumlar", inline = "htfc", group = G_HTF)
color  HTF_DN   = input.color(#C93800, "", inline = "htfc", group = G_HTF)
color  HTF_WICK = input.color(#2E0602, "", inline = "htfc", group = G_HTF)
bool   HTF_GRID = input.bool(true, "Izgara", group = G_HTF)
bool   HTF_LAST = input.bool(true, "Son fiyat çizgisi", group = G_HTF)
bool   HTF_TIME = input.bool(true, "Zaman ekseni", group = G_HTF)
bool   HTF_FVGS = input.bool(true, "FVG'ler", group = G_HTF)
bool   HTF_SMT  = input.bool(true, "SMT", tooltip = "Otomatik: karşı sembol grafikteki sembole göre seçilir. Eşleşme yoksa SMT çizilmez ve mini grafik başlığında SMT yazmaz; o zaman Elle seç.", group = G_HTF)
string SMT_SEL  = input.string("Otomatik", "Karşı sembol", options = ["Otomatik", "Elle"], inline = "smt", group = G_HTF)
string SMT_SYM  = input.symbol("OANDA:GBPUSD", "", inline = "smt", group = G_HTF)
bool   SMT_INV  = input.bool(false, "Elle seçilen sembol ters ilişkili", group = G_HTF)
int    SMT_P    = input.int(2, "SMT swing gücü (mum)", minval = 1, maxval = 5, group = G_HTF)
int    SMT_MAX  = input.int(5, "SMT grup başına en fazla", minval = 1, maxval = 20, tooltip = "Yön başına en yeni uyumsuzluklar çizilir.", group = G_HTF)
color  SMT_BULL = input.color(#2E4A8C, "SMT renkleri", inline = "smtc", group = G_HTF)
color  SMT_BEAR = input.color(#9B1D30, "", inline = "smtc", group = G_HTF)
bool   SMT_MON  = input.bool(true, "Ana grafikte SMT", tooltip = "Otomatik: 1m grafikte 15m, 5m'de 1h, 15m'de 4h, 1h ve 4h'te 1D. Karşı sembol, swing gücü ve renkler yukarıdaki SMT ayarlarından gelir.", group = G_HTF)
string SMT_MSEL = input.string("Otomatik", "Ana grafik SMT zaman dilimi", options = ["Otomatik", "Elle"], inline = "smtm", group = G_HTF)
string SMT_MTF  = input.timeframe("60", "", inline = "smtm", group = G_HTF)
color  SMT_MBULL = input.color(#1D4ED8, "Ana grafik SMT renkleri", inline = "smtmc", group = G_HTF)
color  SMT_MBEAR = input.color(#C93800, "", inline = "smtmc", group = G_HTF)
int    SMT_MMAX = input.int(5, "Ana grafik SMT en fazla", minval = 1, maxval = 20, tooltip = "Yön başına en yeni uyumsuzluklar çizilir.", group = G_HTF)

