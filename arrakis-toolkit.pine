string G_MO  = "Midnight Open"
bool   moOn  = input.bool(true, "Midnight Open", tooltip = "00:00 NY mumunun açılış fiyatı. Çizgi 17:00 NY'ye kadar uzar. 00:00'da mum açılmayan sembol ve zaman dilimlerinde çizilmez.", inline = "mo1", group = G_MO)
color  moCol = input.color(#9C6B12, "", inline = "mo1", group = G_MO)
string moSty = input.string(S_SOLID, "", options = ["Düz", "Kesikli", "Noktalı"], inline = "mo1", group = G_MO)
int    moW   = input.int(1, "", minval = 1, maxval = 4, inline = "mo1", group = G_MO)
int    moN   = input.int(5, "Son kaç gün", minval = 1, maxval = 50, inline = "mo2", group = G_MO)
string moTf  = input.timeframe("60", "En fazla", inline = "mo2", group = G_MO)

// ───────────────────────── FVG ─────────────────────────
string G_FVG  = "FVG"
bool   FVG_ON = input.bool(true, "FVG'leri göster", group = G_FVG)
bool   FVG_CE = input.bool(true, "Orta çizgi (CE)", group = G_FVG)
bool   FVG_TM = input.bool(true, "Kesinleşme zamanını yaz", tooltip = "FVG'nin 3. mumunun kapandığı an (NY saati). Gün içi FVG'lerde gün ve saat, günlük ve üstünde tarih yazar.", group = G_FVG)
bool   fv1On  = input.bool(false, "1m", inline = "fv1", group = G_FVG)
color  fv1Col = input.color(#6B6560, "", inline = "fv1", group = G_FVG)
string fv1Ext = input.string("1 gün", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv1", group = G_FVG)
bool   fv2On  = input.bool(false, "5m", inline = "fv2", group = G_FVG)
color  fv2Col = input.color(#1E7F78, "", inline = "fv2", group = G_FVG)
string fv2Ext = input.string("3 gün", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv2", group = G_FVG)
bool   fv3On  = input.bool(false, "15m", inline = "fv3", group = G_FVG)
color  fv3Col = input.color(#9C6B12, "", inline = "fv3", group = G_FVG)
string fv3Ext = input.string("5 gün", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv3", group = G_FVG)
bool   fv4On  = input.bool(false, "30m", inline = "fv4", group = G_FVG)
color  fv4Col = input.color(#9C6B12, "", inline = "fv4", group = G_FVG)
string fv4Ext = input.string("1 hafta", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv4", group = G_FVG)
bool   fv5On  = input.bool(true, "1h", inline = "fv5", group = G_FVG)
color  fv5Col = input.color(#9B1D30, "", inline = "fv5", group = G_FVG)
string fv5Ext = input.string("2 hafta", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv5", group = G_FVG)
bool   fv6On  = input.bool(true, "4h", inline = "fv6", group = G_FVG)
color  fv6Col = input.color(#4F6F2A, "", inline = "fv6", group = G_FVG)
string fv6Ext = input.string("1 ay", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv6", group = G_FVG)
bool   fv7On  = input.bool(false, "8h", inline = "fv7", group = G_FVG)
color  fv7Col = input.color(#4F6F2A, "", inline = "fv7", group = G_FVG)
string fv7Ext = input.string("2 ay", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv7", group = G_FVG)
bool   fv8On  = input.bool(true, "1D", inline = "fv8", group = G_FVG)
color  fv8Col = input.color(#2E4A8C, "", inline = "fv8", group = G_FVG)
string fv8Ext = input.string("6 ay", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv8", group = G_FVG)
bool   fv9On  = input.bool(true, "1W", inline = "fv9", group = G_FVG)
color  fv9Col = input.color(#5B2A4E, "", inline = "fv9", group = G_FVG)
string fv9Ext = input.string("1 yıl", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv9", group = G_FVG)
bool   fv10On  = input.bool(false, "1M", inline = "fv10", group = G_FVG)
color  fv10Col = input.color(#2E0602, "", inline = "fv10", group = G_FVG)
string fv10Ext = input.string("4 yıl", "Maks. uzatma", options = ["1 gün", "2 gün", "3 gün", "5 gün", "1 hafta", "2 hafta", "1 ay", "2 ay", "3 ay", "6 ay", "1 yıl", "4 yıl", "Sınırsız"], inline = "fv10", group = G_FVG)

// ───────────────────────── Tipler ─────────────────────────
type Slot
    bool   on
    string name
    string sess
    bool   fillOn
    color  fillCol
    bool   bordOn
    color  bordCol
    string bordStyle
    bool   lvlOn
    color  lvlCol
    string lvlStyle
    int    lvlWidth
    bool   active = false
    float  hi     = na
    float  lo     = na
    int    hiBar  = na
    int    loBar  = na
    box    bx     = na
    line   hiLn   = na
    line   loLn   = na
    label  hiLb   = na
    label  loLb   = na
    label  ttl    = na

// Seans bittikten sonra sağa uzayan, temas veya süre dolunca duran seviye
type Level
    line  ln
    label lb
    float price
    bool  isHigh
    int   startBar
    int   endTod
    int   days = 0
    color col  = na
    label xLb  = na
    bool  dead = false

// ───────────────────────── Yardımcılar ─────────────────────────
lineStyle(string s) =>
    switch s
        "Kesikli" => line.style_dashed
        "Noktalı" => line.style_dotted
        => line.style_solid

labelSize(string s) =>
    switch s
        "Çok küçük" => size.tiny
        "Normal"    => size.normal
        => size.small

// Forex'te pip; pip tanımı olmayan sembollerde fiyat farkı "pts" olarak yazılır
bool  isMetal = str.startswith(syminfo.ticker, "XAU") or str.startswith(syminfo.ticker, "XAG")
bool  isForex = syminfo.type == "forex" and not isMetal
float pipSize = syminfo.currency == "JPY" ? 0.01 : 0.0001

slotTitle(Slot s) =>
    float rng = s.hi - s.lo
    s.name + " • " + str.tostring(isForex ? rng / pipSize : rng, "#.0") + (isForex ? " pips" : " pts")

// NY AM saati sembole göre seçilir
bool   fxFut  = syminfo.type == "futures" and str.contains(" 6E 6B 6J 6A 6C 6S 6N M6E M6B M6A DX ", " " + syminfo.root + " ")
bool   fxHour = m3 == "Otomatik" ? isForex or fxFut or syminfo.ticker == "DXY" : m3 == "Forex"
string t3     = fxHour ? t3F : t3I

// Yazı çizginin sonunda ve üstünde durur
newLevelLabel(Slot s, float y, string suffix) =>
    label.new(bar_index, y, s.name + suffix, style = label.style_label_lower_right, color = color.new(color.black, 100), textcolor = s.lvlCol, size = labelSize(LBL_SIZE))

// Fitil değen seviye: TAKEN ayarına göre soluklaşır ve/veya değdiği bara ✕ konur
method markTaken(Level lv) =>
    if TAKEN == "İkisi" or TAKEN == "Soluklaştır"
        lv.ln.set_color(color.new(lv.col, 75))
        lv.lb.set_textcolor(color.new(lv.col, 75))
    if TAKEN == "İkisi" or TAKEN == "✕"
        lv.xLb := label.new(bar_index, lv.price, "✕", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lv.col, size = size.small)

method kill(Level lv) =>
    lv.dead := true
    line.delete(lv.ln)
    label.delete(lv.lb)
    label.delete(lv.xLb)

// ───────────────────────── Bar bilgisi ─────────────────────────
int  tod           = hour(time, TZ) * 60 + minute(time, TZ)
int  dow           = dayofweek(time, TZ)
bool newTradingDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ) and dow != dayofweek.saturday and dow != dayofweek.sunday
bool tfAllowed     = timeframe.in_seconds() <= timeframe.in_seconds(MAX_TF)
bool slotDay       = bar_index > 0 and timeframe.change("D")

var array<Level> pending = array.new<Level>()

// ───────────────────────── Kutu motoru ─────────────────────────
// Biten seans silinmez, sadece soluklaşır; seviyeleri uzamaya devam eder
method fade(Slot s) =>
    if CLEAN and not na(s.bx)
        s.bx.set_border_color(s.bordOn ? color.new(s.bordCol, 65) : na)
        s.bx.set_bgcolor(s.fillOn ? color.new(s.fillCol, 94) : na)
        s.ttl.set_textcolor(color.new(s.bordCol, 65))
        if s.lvlOn
            line.set_color(s.hiLn, color.new(s.lvlCol, 70))
            line.set_color(s.loLn, color.new(s.lvlCol, 70))
            label.set_textcolor(s.hiLb, color.new(s.lvlCol, 70))
            label.set_textcolor(s.loLb, color.new(s.lvlCol, 70))

method update(Slot s, bool allowed) =>
    bool inSession = not na(time(timeframe.period, s.sess + ":1234567", TZ))
    bool inS       = inSession and s.on and allowed
    if slotDay and not s.active
        s.fade()
    if inS and not s.active
        s.fade()
        s.hi    := high
        s.lo    := low
        s.hiBar := bar_index
        s.loBar := bar_index
        s.bx    := box.new(bar_index, high, bar_index, low, border_color = s.bordOn ? s.bordCol : na, border_width = s.bordOn ? 1 : 0, border_style = lineStyle(s.bordStyle), bgcolor = s.fillOn ? s.fillCol : na)
        s.ttl := label.new(bar_index, high, slotTitle(s), style = label.style_label_lower_left, color = color.new(color.black, 100), textcolor = s.bordCol, size = labelSize(LBL_SIZE))
        if s.lvlOn
            s.hiLn := line.new(bar_index, high, bar_index, high, color = s.lvlCol, style = lineStyle(s.lvlStyle), width = s.lvlWidth)
            s.loLn := line.new(bar_index, low, bar_index, low, color = s.lvlCol, style = lineStyle(s.lvlStyle), width = s.lvlWidth)
            s.hiLb := newLevelLabel(s, high, ".H")
            s.loLb := newLevelLabel(s, low, ".L")
    else if inS
        if high > s.hi
            s.hi    := high
            s.hiBar := bar_index
        if low < s.lo
            s.lo    := low
            s.loBar := bar_index
        s.bx.set_top(s.hi)
        s.bx.set_bottom(s.lo)
        s.bx.set_right(bar_index)
        s.ttl.set_y(s.hi)
        s.ttl.set_text(slotTitle(s))
        if s.lvlOn
            s.hiLn.set_xy1(s.hiBar, s.hi)
            s.hiLn.set_xy2(bar_index, s.hi)
            s.loLn.set_xy1(s.loBar, s.lo)
            s.loLn.set_xy2(bar_index, s.lo)
            s.hiLb.set_xy(bar_index, s.hi)
            s.loLb.set_xy(bar_index, s.lo)
    else if s.active and s.lvlOn
        // Seans bitti: seviyeler artık temas/süre kontrolüyle uzar
        pending.push(Level.new(s.hiLn, s.hiLb, s.hi, true, bar_index, tod, 0, s.lvlCol))
        pending.push(Level.new(s.loLn, s.loLb, s.lo, false, bar_index, tod, 0, s.lvlCol))
    s.active := inS

var Slot kz1  = Slot.new(o1,  n1,  t1,  fo1,  fc1,  bo1,  bc1,  bs1,  lo1,  lc1,  ls1,  lw1)
var Slot kz2  = Slot.new(o2,  n2,  t2,  fo2,  fc2,  bo2,  bc2,  bs2,  lo2,  lc2,  ls2,  lw2)
var Slot kz3  = Slot.new(o3,  n3,  t3,  fo3,  fc3,  bo3,  bc3,  bs3,  lo3,  lc3,  ls3,  lw3)
var Slot kz4  = Slot.new(o4,  n4,  t4,  fo4,  fc4,  bo4,  bc4,  bs4,  lo4,  lc4,  ls4,  lw4)

bool allowed = ALL_ON and tfAllowed

kz1.update(allowed)
kz2.update(allowed)
kz3.update(allowed)
kz4.update(allowed)

// ───────────────────────── Ayırıcı motoru ─────────────────────────
type Sep
    bool        on
    string      txt
    color       col
    string      style
    int         width
    int         maxSec
    string      mode  = ""
    int         hh    = 0
    int         mm    = 0
    array<bool> days  = na
    line        futLn = na
    label       futLb = na

int    DAY_MS = 86400000
string EX_TZ  = syminfo.timezone

var array<string> DAY_NAMES   = array.from("Pazar", "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi")
var array<string> MONTH_NAMES = array.from("Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık")

fmtDate(int t) => str.format_time(t, "dd.MM.yyyy", TZ)

noonOf(int t) => timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 12, 0)

withCustom(string auto, string custom) => custom == "" ? auto : auto + " - " + custom

// İşlem günleri (td) time_tradingday gibi UTC 00:00 damgasıyla tutulur
fmtTd(int td) => str.format_time(td, "dd.MM.yyyy", "UTC")

dayText(int td) => DAY_NAMES.get(dayofweek(td, "UTC") - 1) + " - " + fmtTd(td)

mondayOf(int td) => td - ((dayofweek(td, "UTC") + 5) % 7) * DAY_MS

weekText(int td) => fmtTd(mondayOf(td)) + " - " + fmtTd(mondayOf(td) + 6 * DAY_MS)

hourText(int t) => str.format_time(t, "HH:mm", TZ)

skipWeekend(int td) =>
    int d = dayofweek(td, "UTC")
    syminfo.type == "crypto" ? td : d == dayofweek.saturday ? td + 2 * DAY_MS : d == dayofweek.sunday ? td + DAY_MS : td

firstTdOf(int y, int m) => skipWeekend(timestamp("UTC", y, m, 1, 0, 0))

// Mum sınırları doğrudan sembolün kendi saatlik/günlük/haftalık mumlarından gelir
bool newHour    = bar_index > 0 and timeframe.change("60")
bool newDay     = bar_index > 0 and timeframe.change("D")
bool newWeek    = bar_index > 0 and timeframe.change("W")
bool newMonth   = bar_index > 0 and timeframe.change("M")
bool newQuarter = bar_index > 0 and timeframe.change("3M")
bool newYear    = bar_index > 0 and timeframe.change("12M")

// Günlük mumun açılış saati (borsa saatiyle) ve işlem gününden önceki takvim gününde açılıp açılmadığı
int  dOpen    = time("D")
int  openH    = hour(dOpen, EX_TZ)
int  openM    = minute(dOpen, EX_TZ)
bool openPrev = dayofmonth(dOpen, EX_TZ) != dayofmonth(time_tradingday, "UTC")

// Bir işlem gününün günlük mumunun açıldığı an
tdStart(int td) =>
    int d = openPrev ? td - DAY_MS : td
    timestamp(EX_TZ, year(d, "UTC"), month(d, "UTC"), dayofmonth(d, "UTC"), openH, openM)

int   calNoon = noonOf(time)
int   barEnd  = time + timeframe.in_seconds() * 1000
float tfMin   = timeframe.in_seconds() / 60

method visible(Sep s) => s.on and timeframe.in_seconds() <= s.maxSec

method draw(Sep s, string txt) =>
    line.new(bar_index, low, bar_index, high, extend = extend.both, color = s.col, style = lineStyle(s.style), width = s.width)
    if txt != ""
        label.new(bar_index, high, txt, yloc = yloc.abovebar, style = label.style_label_lower_left, color = color.new(color.black, 100), textcolor = color.new(s.col, CLEAN ? 40 : 0), size = labelSize(SEP_LBL))

// Gelecekteki ayırıcı: son barda silinip yeniden çizilir, yazısı son fiyat hizasında
method drawFuture(Sep s, bool show, int t, string txt) =>
    line.delete(s.futLn)
    label.delete(s.futLb)
    s.futLb := na
    if show
        s.futLn := line.new(t, low, t, high, xloc = xloc.bar_time, extend = extend.both, color = s.col, style = lineStyle(s.style), width = s.width)
        s.futLb := label.new(t, close, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(s.col, 0), size = labelSize(SEP_LBL))

method isTimeMode(Sep s) => s.mode == "Saat + günler" or s.mode == "Saat"

method fires(Sep s) =>
    int target = s.hh * 60 + s.mm
    switch s.mode
        "Aylık"    => newMonth
        "Üç aylık" => newQuarter
        "Yıllık"   => newYear
        => s.days.get(dow - 1) and tod <= target and tod + tfMin > target

// Saat türlerinde t = takvim günü (NY öğlen), dönem türlerinde t = işlem günü (UTC)
method eventText(Sep s, int t) =>
    switch s.mode
        "Aylık"    => MONTH_NAMES.get(month(t, "UTC") - 1) + " " + str.tostring(year(t, "UTC"))
        "Üç aylık" => "Q" + str.tostring(int((month(t, "UTC") - 1) / 3) + 1) + " " + str.tostring(year(t, "UTC"))
        "Yıllık"   => str.tostring(year(t, "UTC"))
        "Saat"     => str.format("{0,number,00}:{1,number,00}", s.hh, s.mm)
        => DAY_NAMES.get(dayofweek(t, TZ) - 1) + " " + str.format("{0,number,00}:{1,number,00}", s.hh, s.mm) + " - " + fmtDate(t)

// Sıradaki olayın [başlangıç zamanı, yazı için gün damgası]
nextEvent(Sep s) =>
    int t   = na
    int day = na
    if s.isTimeMode()
        for k = 0 to 7
            int n = calNoon + k * DAY_MS
            int c = timestamp(TZ, year(n, TZ), month(n, TZ), dayofmonth(n, TZ), s.hh, s.mm)
            if s.days.get(dayofweek(n, TZ) - 1) and c >= barEnd
                t   := c
                day := n
                break
    else
        int y = year(time_tradingday, "UTC")
        int m = month(time_tradingday, "UTC")
        m := s.mode == "Aylık" ? m + 1 : s.mode == "Üç aylık" ? int((m - 1) / 3) * 3 + 4 : 13
        if m > 12
            y += 1
            m -= 12
        day := firstTdOf(y, m)
        t   := tdStart(day)
    [t, day]

var Sep sepH  = Sep.new(hOn, hTxt, hCol, hSty, hW, timeframe.in_seconds(hTf))
var Sep sepM  = Sep.new(mOn, mTxt, mCol, mSty, mW, timeframe.in_seconds(mTf), "Saat", 9, 30, array.from(false, true, true, true, true, true, false))
var Sep sepD  = Sep.new(dOn, dTxt, dCol, dSty, dW, timeframe.in_seconds(dTf))
var Sep sepW  = Sep.new(wOn, wTxt, wCol, wSty, wW, timeframe.in_seconds(wTf))
var Sep sepX1 = Sep.new(x1On, x1Txt, x1Col, x1Sty, x1W, timeframe.in_seconds(x1Tf), x1Md, x1H, x1M, array.from(x1d1, x1d2, x1d3, x1d4, x1d5, x1d6, x1d7))
var Sep sepX2 = Sep.new(x2On, x2Txt, x2Col, x2Sty, x2W, timeframe.in_seconds(x2Tf), x2Md, x2H, x2M, array.from(x2d1, x2d2, x2d3, x2d4, x2d5, x2d6, x2d7))
var Sep sepX3 = Sep.new(x3On, x3Txt, x3Col, x3Sty, x3W, timeframe.in_seconds(x3Tf), x3Md, x3H, x3M, array.from(x3d1, x3d2, x3d3, x3d4, x3d5, x3d6, x3d7))

method run(Sep s) =>
    if s.visible() and s.fires()
        s.draw(s.mode == "Saat" ? s.txt : withCustom(s.eventText(s.isTimeMode() ? calNoon : time_tradingday), s.txt))
    if barstate.islast
        [t, day] = nextEvent(s)
        string futTxt = na(day) ? "" : withCustom(s.eventText(day), s.txt)
        s.drawFuture(SEP_FUT and s.visible() and not na(t), t, futTxt)

// Saat başı tam saate düşmeyen sembollerde (hisse: 09:30, 10:30) yazı eskisi gibi mumun üstünde kalır
bool hTop = minute(time("60"), TZ) != 0

// Çakışmada öncelik: haftalık > günlük > saatlik
bool wVis = sepW.visible()
bool dVis = sepD.visible()
if wVis and newWeek
    sepW.draw(withCustom(weekText(time_tradingday), sepW.txt))
else if dVis and newDay
    sepD.draw(withCustom(dayText(time_tradingday), sepD.txt))
else if sepH.visible() and newHour
    sepH.draw(hTop ? withCustom(hourText(time("60")), sepH.txt) : sepH.txt)

// Sıradaki mumlar: hafta kapanışını geçen günlük mum bir sonraki haftanın ilk işlem gününe kayar
if barstate.islast
    int nextWeekTd = mondayOf(time_tradingday) + 7 * DAY_MS
    int nextWeekT  = tdStart(nextWeekTd)
    int nextDayTd  = skipWeekend(time_tradingday + DAY_MS)
    int nextDayT   = tdStart(nextDayTd)
    int weekClose  = time_close("W")
    if not na(weekClose) and nextDayT >= weekClose
        nextDayTd := nextWeekTd
        nextDayT  := nextWeekT
    int hourClose = time_close("60")
    int nextHourT = na(hourClose) ? time("60") + 3600000 : hourClose
    sepW.drawFuture(SEP_FUT and wVis, nextWeekT, withCustom(weekText(nextWeekTd), sepW.txt))
    sepD.drawFuture(SEP_FUT and dVis and not (wVis and nextDayT == nextWeekT), nextDayT, withCustom(dayText(nextDayTd), sepD.txt))
    sepH.drawFuture(SEP_FUT and sepH.visible() and not (wVis and nextHourT == nextWeekT) and not (dVis and nextHourT == nextDayT), nextHourT, withCustom(hourText(nextHourT), sepH.txt))

sepX1.run()
sepX2.run()
sepX3.run()
sepM.run()

